{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=ticket;Username=ticket;Password=ticket"
  },
  "Jwt": {
    "Issuer": "Ticket.Api",
    "Audience": "Ticket.Client",
    "SigningKey": "Change-this-development-signing-key-before-production-2026",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "Cors": {
    "Origins": [ "http://localhost:5173" ]
  },
  "Attachments": {
    "MaxFileSizeBytes": 5242880,
    "AllowedContentTypes": [
      "image/png",
      "image/jpeg",
      "application/pdf",
      "text/plain"
    ]
  },
  "AllowedHosts": "*"
}
