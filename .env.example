# Copy to .env (never commit .env) or set in your shell / Cursor MCP env.
# Required for the API, EF migrations, and Postgres MCP. SQLite is not supported.

TICKET_DATABASE_URL=Host=localhost;Port=5432;Database=ticket;Username=ticket;Password=CHANGE_ME
# Or URI form for MCP:
# TICKET_DATABASE_URL=postgresql://ticket:CHANGE_ME@localhost:5432/ticket
